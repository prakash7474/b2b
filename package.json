{
  "name": "b2p",
  "version": "1.0.0",
  "description": "B2P (Batter-to-Plate) React Native Admin & Vendor Application",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:backend": "python -m pytest tests/ -v --tb=long",
    "test:backend:coverage": "python -m pytest tests/ -v --tb=long --cov --cov-report=term-missing --cov-report=html:htmlcov --cov-report=xml:coverage.xml --junitxml=test-results/junit.xml",
    "test:frontend": "jest",
    "test": "npm run test:backend",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/js-polyfills": "0.86.3",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "expo": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-native": "~0.73.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.0"
  }
}
